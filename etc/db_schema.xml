<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="catalog_product_entity_media_gallery">
        <column xsi:type="smallint" name="ai_content" unsigned="true" nullable="false" identity="false"
                default="0" comment="EU AI Act label: 0 = none, 1 = AI generated, 2 = AI modified"/>
        <column xsi:type="varchar" name="ai_label_color" nullable="true" length="8"
                comment="EU AI Act label icon color: black or white"/>
        <index referenceId="CATALOG_PRODUCT_ENTITY_MEDIA_GALLERY_VALUE" indexType="btree">
            <column name="value"/>
        </index>
    </table>
</schema>
