<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\CustomerData\ItemInterface">
        <plugin name="customgento_ai_image_label_cart_item_data"
                type="CustomGento\AiImageLabel\Plugin\AddAiLabelToCartItemDataPlugin"/>
    </type>
    <type name="Magento\Catalog\Block\Product\ImageFactory">
        <plugin name="customgento_ai_image_label_product_image"
                type="CustomGento\AiImageLabel\Plugin\AddAiBadgeToProductImagePlugin"/>
    </type>
    <type name="Magento\Catalog\Block\Product\Image">
        <plugin name="customgento_ai_image_label_product_image"
                type="CustomGento\AiImageLabel\Plugin\AddAiBadgeToProductImagePlugin"/>
    </type>
    <type name="Magento\ConfigurableProduct\Block\Product\View\Type\Configurable">
        <plugin name="customgento_ai_image_label_configurable_images"
                type="CustomGento\AiImageLabel\Plugin\AddAiLabelToConfigurableImagesPlugin"/>
    </type>
</config>
