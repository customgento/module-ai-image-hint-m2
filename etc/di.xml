<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Catalog\Model\ResourceModel\Product\Gallery">
        <plugin name="customgento_ai_image_label_load_columns"
                type="CustomGento\AiImageLabel\Plugin\GalleryResourcePlugin"/>
    </type>
    <type name="Magento\Catalog\Model\Product\Gallery\CreateHandler">
        <plugin name="customgento_ai_image_label_save"
                type="CustomGento\AiImageLabel\Plugin\SaveAiFlagsPlugin"/>
    </type>
    <type name="Magento\Catalog\Block\Product\View\Gallery">
        <plugin name="customgento_ai_image_label_gallery_json"
                type="CustomGento\AiImageLabel\Plugin\AddAiLabelToGalleryJsonPlugin"/>
    </type>
</config>
