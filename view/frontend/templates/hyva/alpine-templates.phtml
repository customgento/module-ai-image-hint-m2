<?php

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;

/**
 * Adds the AI hint to the Alpine templates of the Hyvä product gallery and cart drawer. This runs while the page is
 * parsed, before Alpine (a deferred module script) starts, so Alpine renders the badge as if the theme template had
 * it. Main gallery image: images[active].aiIcon, thumbnails: image.aiMark (see AddAiHintToGalleryJsonPlugin), cart
 * drawer: item.product_image.ai_image_hint (see AddAiHintToCartItemDataPlugin). The Hyvä 1.5+ gallery renders its
 * slides on the server, so there the badges are added to the slides and the lightbox once Alpine has read the
 * gallery JSON.
 *
 * @var ViewModelRegistry $viewModels
 */
?>
<script>
(() => {
    'use strict';

    // Alpine's CSP build evaluates plain property paths only, so the badges read their hint through this magic:
    // the cart item, the thumbnail or the active gallery image, whichever the badge sits in
    document.addEventListener('alpine:init', () => {
        Alpine.magic('aiHint', (el) => {
            const {item, image, images, active} = Alpine.$data(el);
            const hint = item ? item.product_image?.ai_image_hint
                : image ? image.aiMark && {icon: image.aiMark, alt: image.aiAlt}
                : images?.[active]?.aiIcon && {icon: images[active].aiIcon, alt: images[active].aiAlt};

            return hint ? {show: true, icon: hint.icon, alt: hint.alt} : {show: false, icon: '', alt: ''};
        });
    });

    const badge = (size) => {
        const template = document.createElement('template');
        template.setAttribute('x-if', '$aiHint.show');
        template.innerHTML = `<img class="ai-image-hint ${size}" :src="$aiHint.icon" :alt="$aiHint.alt"`
            + ' :title="$aiHint.alt">';
        return template;
    };

    const icon = (src, alt, size) => Object.assign(document.createElement('img'), {
        src, alt, title: alt, className: `ai-image-hint ${size}`,
    });

    // Hyvä 1.5+ snap slider: slides and pager thumbs are server rendered, main image first, so each one is
    // matched to its gallery JSON entry by the large image url
    const slider = document.querySelector('#gallery[data-slider-type="gallery"]');
    if (slider) {
        document.addEventListener('alpine:initialized', () => {
            const gallery = Alpine.$data(slider);
            const images = gallery.initImages || [];
            images.forEach(({full, aiIcon, aiMark, aiAlt}) => {
                const slide = aiIcon && [...slider.querySelectorAll('[data-track] [data-img-src]')]
                    .find((button) => button.dataset.imgSrc === full)?.parentElement;
                if (!slide) {
                    return;
                }
                slide.append(icon(aiIcon, aiAlt, 'ai-image-hint--full ai-image-hint--slide'));

                // no image with the "dots" pager, and Hyvä shows the thumb image from lg up only, so the mark does too
                const thumb = slider.querySelector(`[data-pager] a[href="#${slide.id}"]`);
                if (thumb?.querySelector('img')) {
                    thumb.classList.add('ai-image-hint-host');
                    thumb.append(icon(aiMark, aiAlt, 'ai-image-hint--thumb hidden lg:block'));
                }
            });

            // the lightbox shows the large image of the slide it was opened or paged to, lightbox.src is its url
            const lightboxImage = slider.querySelector('dialog img[\\:src="lightbox.src"]');
            if (!lightboxImage || !images.some(({aiIcon}) => aiIcon)) {
                return;
            }
            const wrap = Object.assign(document.createElement('span'), {className: 'ai-image-hint-wrap'});
            const lightboxBadge = icon('', '', 'ai-image-hint--full');
            lightboxImage.replaceWith(wrap);
            wrap.append(lightboxImage, lightboxBadge);
            Alpine.effect(() => {
                const hint = images.find(({full, aiIcon}) => aiIcon && full === gallery.lightbox.src);
                lightboxBadge.hidden = !hint;
                if (hint) {
                    Object.assign(lightboxBadge, {src: hint.aiIcon, alt: hint.aiAlt, title: hint.aiAlt});
                }
            });
        });
    } else {
        document.getElementById('gallery-main')?.append(badge('ai-image-hint--full'));
    }

    // x-for / x-if contents are document fragments of their own, nested templates included
    const patch = (root) => root.querySelectorAll('template').forEach(({content}) => {
        content.querySelectorAll('img[\\:src="image.thumb"]').forEach((img) => {
            img.after(badge('ai-image-hint--thumb'));
        });
        content.querySelectorAll('img[\\:src="item.product_image.src"]').forEach((img) => {
            img.parentElement.classList.add('ai-image-hint-host');
            img.after(badge(''));
        });
        patch(content);
    });
    patch(document);
})();
</script>
<?php if (class_exists(HyvaCsp::class)): ?>
    <?php $viewModels->require(HyvaCsp::class)->registerInlineScript() ?>
<?php endif; ?>
