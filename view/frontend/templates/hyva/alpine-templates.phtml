<?php

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;

/**
 * Adds the AI hint to the Alpine templates of the Hyvä product gallery and cart drawer. This runs while the page is
 * parsed, before Alpine (a deferred module script) starts, so Alpine renders the badge as if the theme template had
 * it. Main gallery image: images[active].aiIcon, thumbnails: image.aiMark (see AddAiHintToGalleryJsonPlugin), cart
 * drawer: item.product_image.ai_image_hint (see AddAiHintToCartItemDataPlugin).
 *
 * @var ViewModelRegistry $viewModels
 */
?>
<script>
(() => {
    'use strict';

    const badge = (src, alt, size) => {
        const template = document.createElement('template');
        template.setAttribute('x-if', src);
        template.innerHTML = `<img class="ai-image-hint ${size}" :src="${src}" :alt="${alt}" :title="${alt}">`;
        return template;
    };

    document.getElementById('gallery-main')
        ?.append(badge('images[active]?.aiIcon', 'images[active]?.aiAlt', 'ai-image-hint--full'));

    // x-for / x-if contents are document fragments of their own, nested templates included
    const patch = (root) => root.querySelectorAll('template').forEach(({content}) => {
        content.querySelectorAll('img[\\:src="image.thumb"]').forEach((img) => {
            img.after(badge('image.aiMark', 'image.aiAlt', 'ai-image-hint--thumb'));
        });
        content.querySelectorAll('img[\\:src="item.product_image.src"]').forEach((img) => {
            img.parentElement.classList.add('ai-image-hint-host');
            img.after(badge('item.product_image.ai_image_hint?.icon', 'item.product_image.ai_image_hint?.alt', ''));
        });
        patch(content);
    });
    patch(document);
})();
</script>
<?php if (class_exists(HyvaCsp::class)): ?>
    <?php $viewModels->require(HyvaCsp::class)->registerInlineScript() ?>
<?php endif; ?>
